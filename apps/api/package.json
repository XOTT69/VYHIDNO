    "import:feed": "node scripts/import-feed.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
